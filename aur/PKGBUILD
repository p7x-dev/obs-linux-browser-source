# Maintainer: p7x-dev <rammleid123@gmail.com>

pkgname=obs-widget-browser
pkgver=0.1.2
pkgrel=1
pkgdesc="Qt WebEngine-based browser widget source for OBS Studio (no CEF)"
arch=('x86_64')
url="https://github.com/p7x-dev/obs-linux-browser-source"
license=('GPL-2.0-only')
depends=('obs-studio' 'qt6-base' 'qt6-declarative' 'qt6-webchannel' 'qt6-webengine' 'gcc-libs')
makedepends=('cmake' 'ninja')
conflicts=("${pkgname}-git")
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('fa86b224e58b9921fc2ccb3b0ba0d7926aee60b361fd013d8806dea7c76ed28f')

build() {
    cd "$srcdir/obs-linux-browser-source-$pkgver"
    cmake -B build -S . -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build
}

check() {
    cd "$srcdir/obs-linux-browser-source-$pkgver"
    ctest --test-dir build --output-on-failure
}

package() {
    cd "$srcdir/obs-linux-browser-source-$pkgver"
    DESTDIR="$pkgdir" cmake --install build

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    cp -r docs "$pkgdir/usr/share/doc/$pkgname/"
}
